VITE_LL2_API_KEY=
# Public YouTube video ID for Live Launch (11 chars, no URL). UI paste overrides and is stored in localStorage.
# Prefer IDs that allow embedding. Some SpaceX webcasts return YouTube errors 101/150 (embedding disabled)
# even when the watch page works — the app then shows Open on YouTube. Default recap hI9HQfCAw64 is oEmbed-allowed
# but YouTube may still bot-check datacenter/in-page players.
VITE_YOUTUBE_VIDEO_ID=hI9HQfCAw64
